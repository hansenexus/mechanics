---
/**
 * The same card the screenshots are shot in — chrome dots, caption bar,
 * monospace body — ported from `scripts/shots.mjs` so terminal output on this
 * page is visually identical to `docs/images/*.png`.
 *
 * It is dark in BOTH site themes. A terminal is dark, the screenshots beside
 * it are dark, and a card that flips to white in light mode would stop being a
 * picture of the tool and start being a quotation of it. That is why it draws
 * from the `--terminal-*` tokens rather than `--panel` / `--fg`.
 *
 * Rendered as real text rather than an image on purpose: it is selectable,
 * copyable, sharp at any density, and it reflows on a phone, which a
 * 1180px-wide PNG does not.
 */
interface Props {
  caption: string;
  command?: string;
}

const { caption, command } = Astro.props;
---

<section class="card">
  <div class="chrome">
    <i></i><i></i><i></i><span>{caption}</span>
  </div>
  <pre>{command && <><span class="prompt">$</span> <span class="cmd">{command}</span>{"\n"}</>}<slot /></pre>
</section>

<style>
  .card {
    border-radius: var(--radius);
    background: var(--terminal);
    overflow: hidden;
    box-shadow: 0 20px 50px -28px rgba(25, 27, 30, 0.5);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 17px;
    border-bottom: 1px solid var(--terminal-line);
  }

  .chrome i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #34363c;
    flex: none;
  }

  .chrome span {
    margin-left: 9px;
    color: var(--terminal-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  pre {
    margin: 0;
    padding: 17px 20px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    white-space: pre;
    color: var(--terminal-text);
  }

  @media (max-width: 560px) {
    pre {
      font-size: 11px;
      padding: 13px 14px;
    }
  }
</style>
